MAINNET_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY"
FORK_RPC_URL="http://127.0.0.1:8545"

CHAINLINK_AGENTS_GATEWAY_URL="https://agents.chain.link"

# Chainlink for Agents gateway signer key. Used by the agent/skill for gateway registration,
# EIP-191/EIP-712 signing, and x402 payments. Keep this separate from the fork swap wallet.
AGENT_PRIVATE_KEY=""

# Local Anvil fork swap wallet key. Used only by demo scripts to execute Uniswap swaps on the fork.
# Do not use a real mainnet wallet private key here. Anvil's first default key is convenient for demos.
PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
PORTFOLIO_ADDRESS="0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266"

DRY_RUN="true"
REBALANCE_THRESHOLD_BPS="500"
SLIPPAGE_BPS="50"
STALE_PRICE_SECONDS="86400"
UNISWAP_FEE_TIER="500"

# Optional seed overrides for fork demos.
SEED_WETH="20"
SEED_WBTC="0.05"
SEED_USDC="10000"
# Defaults are Uniswap V3 pool addresses with deep mainnet liquidity.
WETH_WHALE="0x88e6a0c2ddd26feeb64f039a2c41296fcb3f5640"
WBTC_WHALE="0xcbcdf9626bc03e24f779434178a73a0b4bad62ed"
USDC_WHALE="0x88e6a0c2ddd26feeb64f039a2c41296fcb3f5640"
